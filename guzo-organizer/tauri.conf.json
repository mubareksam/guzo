{
  "productName": "Guzo Organizer",
  "version": "1.0.0",
  "identifier": "et.guzo.organizer",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 1420",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../src/out"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Guzo Organizer — File Organizer for Windows",
        "width": 1280,
        "height": 800,
        "minWidth": 1100,
        "minHeight": 680,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "signCommand": null,
      "iconPath": "icons/icon.ico",
      "nsis": {
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  },
  "plugins": {
    "dialog": {},
    "fs": {
      "scope": ["$APPDATA/*", "$RESOURCE/*", "$DOWNLOAD/*", "$DOCUMENT/*", "$PICTURE/*", "$VIDEO/*", "$AUDIO/*", "**"]
    },
    "shell": {
      "open": true
    }
  }
}
